      "destination": "/mission",
      "permanent": true
    },
    {
      "source": "/board-members",
      "destination": "/founders",
      "permanent": true
    },
    {
      "source": "/nabme-fellowship-program",
      "destination": "/athari",
      "permanent": true
    },
    {
      "source": "/resumes",
      "destination": "/resume-bank",
      "permanent": true
    },
    {
      "source": "/give",
      "destination": "/donate",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/nabme-careersw",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/talent-portal",
      "destination": "/talent",
      "permanent": true
    },
    {
      "source": "/my-jobs",
      "destination": "/jobs",
      "permanent": true
    },
    {
      "source": "/submit-job",
      "destination": "/post-job",
      "permanent": true
    },
    {
      "source": "/resumes-2",
      "destination": "/resume-bank",
      "permanent": true
    },
    {
      "source": "/submit-resume",
      "destination": "/resume-bank",
      "permanent": true
    },
    {
      "source": "/candidate-dashboard",
      "destination": "/resume-bank",
      "permanent": true
    },
    {
      "source": "/resume/:slug*",
      "destination": "/resume-bank",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/author/:slug*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/wp-admin",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/summit/register",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}